{
  "name": "dcuo-wiki",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/wiki/*",
      "/guides",
      "/guides/*",
      "/releases/*",
      "/story",
      "/story/*",
      "/",
    ],
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "dcuo-wiki.com",
      "custom_domain": true,
    },
  ],
  "main": "worker/index.mjs",
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dcuo-wiki-images" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcuo-wiki-accounts",
      "database_id": "1b3140dd-8d8e-49cc-ab3b-cfd0104efaa9",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "SITE_ORIGIN": "https://dcuo-wiki.com",
  },
}
