---
import { articleParts } from "../../shared/article-content.mjs";
import type { Article } from "../data/articles";
interface Props {
  article: Article;
}
const { article } = Astro.props;
const parts = articleParts(article);
---

<details
  id="article-editor"
  class="account account-card article-editor"
  data-page={article.title}
  data-slug={article.slug}
>
  <summary>Edit this page</summary>
  <p>
    Corrections publish immediately after your Discord session and Census
    character match are checked. Every change is recorded in public edit history
    with your character name.
  </p>
  <p id="edit-status" role="status" aria-live="polite">
    Checking your player account...
  </p>
  <p id="edit-account" hidden>
    <a href={`/account/?page=${encodeURIComponent(article.title)}`}>
      Sign in or match your character
    </a>{" "}
    to unlock edits. Your draft stays in this browser tab.
  </p>
  <noscript>
    JavaScript is required to edit. Published articles remain readable without
    it.
  </noscript>
  <form id="article-edit-form" hidden>
    <p id="edit-help">
      Select any article section below to edit its current content. Tables,
      maps, and video links have their own entries. Each section publishes
      separately.
    </p>
    <label>
      Section to edit
      <select
        id="edit-part"
        name="part"
        size={Math.min(parts.length, 8)}
        aria-describedby="edit-help"
      >
        {parts.map((part, i) => (
          <option value={i}>{part.title}</option>
        ))}
      </select>
    </label>
    <label>
      Proposed text
      <textarea
        id="edit-text"
        name="replacement"
        rows="10"
        required
        maxlength="7000"
      >{parts[0].text}</textarea>
    </label>
    <details class="edit-original">
      <summary>View currently published text</summary>
      <pre id="edit-original">{parts[0].text}</pre>
    </details>
    <label>
      What changed and why?
      <textarea
        name="reason"
        rows="2"
        required
        minlength="10"
        maxlength="500"
      ></textarea>
    </label>
    <label>
      Sources or in-game evidence
      <textarea
        name="sources"
        rows="3"
        required
        minlength="10"
        maxlength="2000"
      ></textarea>
    </label>
    <p>
      Keep useful map locations and quest-specific video references. Include
      evidence for factual corrections.
    </p>
    <button id="submit-edit" disabled>
      Publish correction
    </button>
    <button type="button" id="reset-edit">
      Discard this draft
    </button>
  </form>
</details>
<details id="edit-history" class="account account-card">
  <summary>Page edit history</summary>
  <div id="edit-history-list"></div>
</details>
<script src="../scripts/article-editor.ts"></script>
