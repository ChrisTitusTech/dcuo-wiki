---
import Layout from "../../layouts/Layout.astro";
import ArticleEditor from "../../components/ArticleEditor.astro";
import { renderMapLinks } from "../../../shared/media.mjs";
import articles from "../../data/articles";
export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}
const { article } = Astro.props;
const related = articles.filter((a) => article.related?.includes(a.slug));
---

<Layout title={article.title} description={article.summary}>
  <div class="article-top">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Main page</a>
      <span>/</span>
      <a href={`/?category=${encodeURIComponent(article.category)}#library`}>
        {article.category}
      </a>
    </nav>

    <h1>{article.title}</h1>
    <p class="lede" data-live-part="summary">
      {article.summary}
    </p>
    <div class="article-tools">
      <span class="badge">Source reviewed · {article.retrieved}</span>
      <a href="#article-editor">Edit this page</a>
      <a href={article.history}>Source history ↗</a>
    </div>
  </div>
  <div class="article-grid">
    <aside class="toc">
      <strong>Contents</strong>
      <nav aria-label="Table of contents">
        {article.sections.map((s, i) => (
          <a href={`#section-${i}`}>{s.title}</a>
        ))}
        {article.location && <a href="#location">Location & maps</a>}
      </nav>
    </aside>
    <article>
      {article.sections.map((s, i) => (
        <section id={`section-${i}`}>
          <a
            class="section-edit"
            href="#article-editor"
            data-edit-part={`section-${i}`}
            aria-label={`Edit ${s.title}`}
          >
            Edit section
          </a>
          <h2>{s.title}</h2>
          <div data-live-part={`section-${i}`}>
            <ul>
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          {s.images && (
            <div
              class="section-images"
              data-live-part={`images-${i}`}
              set:html={renderMapLinks(s.images.map((m) => [m.label, m.url]))}
            />
          )}
          {s.references && (
            <p class="section-references">
              Further reading on the source wiki:{" "}
              {s.references.map((r, index) => (
                <>
                  {index > 0 && " · "}
                  <a href={r.url}>{r.label}</a>
                </>
              ))}
            </p>
          )}
          {s.table && (
            <>
              <a
                class="section-edit"
                href="#article-editor"
                data-edit-part={`table-${i}`}
                aria-label={`Edit ${s.title} table`}
              >
                Edit table
              </a>
              <div
                data-live-part={`table-${i}`}
                class="table-scroll"
                tabindex="0"
                role="region"
                aria-label={s.table.caption}
              >
                <table>
                  <caption>{s.table.caption}</caption>
                  <thead>
                    <tr>
                      {s.table.columns.map((c) => (
                        <th scope="col">{c}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((row) => (
                      <tr>
                        {row.map((cell) => (
                          <td>{cell}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )}
        </section>
      ))}
      {article.location && (
        <section id="location">
          <div class="eyebrow">FIND YOUR WAY</div>
          <a
            class="section-edit"
            href="#article-editor"
            data-edit-part="location-maps"
          >
            Edit map links
          </a>
          <h2 data-live-part="location-label">{article.location.label}</h2>
          <p>
            Precision:{" "}
            <span data-live-part="location-precision">
              {article.location.precision}
            </span>
            . No coordinates have been inferred.{" "}
            <a href={article.location.source}>Location evidence</a>.
          </p>
          <div
            data-live-part="location-maps"
            set:html={renderMapLinks(
              article.location.maps.map((m) => [m.label, m.url]),
            )}
          />
          <p class="map-note">
            Select a map to open the full-size image. Copies are hosted by DCUO
            Wiki; original sources are credited below.
          </p>
        </section>
      )}
      {article.locationLimitation && (
        <section>
          <a
            class="section-edit"
            href="#article-editor"
            data-edit-part="location-research"
          >
            Edit location research
          </a>
          <h2>Location research</h2>
          <p data-live-part="location-research">{article.locationLimitation}</p>
        </section>
      )}
      {article.videoReview && (
        <section>
          <a
            class="section-edit"
            href="#article-editor"
            data-edit-part="videos"
          >
            Edit video walkthroughs
          </a>
          <h2>Video walkthroughs</h2>
          <div data-live-part="videos">
            {article.videos?.length ? (
              <ul>
                {article.videos.map((video) => (
                  <li>
                    <a
                      href={
                        video.startSeconds
                          ? `${video.url}&t=${video.startSeconds}s`
                          : video.url
                      }
                    >
                      {video.title}
                    </a>
                    <p>{video.evidence}</p>
                  </li>
                ))}
              </ul>
            ) : (
              <p>
                No quest-specific video verified in the search performed on{" "}
                {article.videoReview.checked}. This does not mean none exists.
              </p>
            )}
          </div>
        </section>
      )}
      {related.length > 0 && (
        <section>
          <h2>Related guides</h2>
          <ul>
            {related.map((a) => (
              <li>
                <a href={`/wiki/${a.slug}/`}>{a.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <aside class="notice">
        <strong>Source & accuracy</strong>
        <p>
          Adapted and condensed from{" "}
          <a href={article.source}>DC Universe Online Wiki contributors</a>.{" "}
          <a href={article.history}>Contributor history</a> ·{" "}
          <a href="https://www.fandom.com/licensing">Source licensing</a>. Text
          adaptations retain the source's applicable CC-BY-SA license. Source
          review is not in-game verification.
        </p>
      </aside>
    </article>
  </div>
  <ArticleEditor article={article} />
</Layout>
