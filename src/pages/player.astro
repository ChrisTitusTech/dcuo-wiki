---
import EquipmentPanel from "../components/EquipmentPanel.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Player profile">
  <section class="prose account">
    <h1 id="player-name">Player profile</h1>
    <p id="player-status" role="status">
      Loading profile...
    </p>
    <div id="player-details" hidden>
      <p id="player-stats"></p>
      <p id="player-bio"></p>
      <EquipmentPanel />
      <p>
        Census matched means the character appears in Daybreak's public data.
        Ownership is not verified. Stats reflect the last profile save.
      </p>
    </div>
    <p>
      <a href="/account/">Create or update your profile</a>
    </p>
  </section>
  <script>
    import { equipmentPanel } from "../scripts/equipment";
    const equipment = equipmentPanel();
    const status = document.getElementById("player-status")!;
    const id = new URLSearchParams(location.search).get("id");
    async function load() {
      if (!id || !/^[a-f0-9-]{36}$/.test(id)) {
        status.textContent = "Open a profile using its shareable link.";
        return;
      }
      try {
        const response = await fetch(`/api/profiles/${id}`);
        const p = await response.json();
        if (!response.ok) throw new Error(p.error);
        document.getElementById("player-name")!.textContent = p.character.name;
        document.getElementById("player-stats")!.textContent =
          `World ${p.character.world_id} | Level ${p.character.level} | Combat rating ${p.character.combat_rating} | Skill points ${p.character.skill_points}`;
        document.getElementById("player-bio")!.textContent = p.bio;
        status.textContent = `Census matched on ${new Date(p.matchedAt * 1000).toLocaleDateString()}`;
        document.getElementById("player-details")!.hidden = false;
        equipment.setProfile(p);
        fetch("/api/me", { credentials: "same-origin" })
          .then(async (r) => {
            if (!r.ok) return;
            const me = await r.json();
            if (
              me.profile?.id === p.id &&
              me.profile.character.character_id === p.character.character_id &&
              me.profile.character.world_id === p.character.world_id
            )
              equipment.setProfile(p, true);
          })
          .catch(() => {});
      } catch (e) {
        status.textContent =
          (e as Error).message || "Profile is temporarily unavailable.";
      }
    }
    load();
  </script>
</Layout>
